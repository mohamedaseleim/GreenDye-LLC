{
  "name": "greendye-consulting-backend",
  "version": "1.8.0",
  "description": "Production API for GreenDye for Training and Consultancy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "expire-accreditations": "node jobs/accreditationExpiry.js",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "preflight": "node ../deployment/scripts/preflight.js",
    "quality-gate": "node ../deployment/scripts/quality-gate.js",
    "migrate:money": "node scripts/migrate-money-minor-units.js",
    "migrate:money:dry": "node scripts/migrate-money-minor-units.js --dry-run",
    "migrate:credentials": "node scripts/migrate-certificate-credentials.js",
    "migrate:credential-references": "node scripts/migrate-credential-references.js"
  },
  "keywords": [
    "consulting",
    "projects",
    "certificates",
    "trainers",
    "api"
  ],
  "author": "GreenDye for Training and Consultancy",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.0",
    "express-validator": "^7.0.1",
    "extract-zip": "^2.0.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^4.15.3",
    "mongo-sanitize": "^1.0.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.13.0",
    "posthog-node": "^3.1.3",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "stripe": "^19.2.1",
    "uuid": "^9.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "prettier": "^3.3.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  }
}
