NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/green_consulting
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/green_consulting_test
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
FROM_NAME=GreenDye for Training and Consultancy
MOODLE_BASE_URL=https://learning.example.com
# Optional integrations. Leave blank when disabled.
FIREBASE_SERVICE_ACCOUNT=
POSTHOG_API_KEY=
POSTHOG_HOST=
FIXER_API_KEY=
FAWRY_MERCHANT_CODE=
FAWRY_SECRET_KEY=
FAWRY_API_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# Destructive database restore/import safety switch. Keep false unless performing a controlled recovery.
ALLOW_PRODUCTION_RESTORE=false

PROJECT_STORAGE_QUOTA_BYTES=1073741824
USER_DAILY_UPLOAD_BYTES=262144000

# Optional. Automatically generated if empty.
INSTANCE_ID=

MALWARE_SCAN_ENABLED=false
CLAMSCAN_COMMAND=clamscan
MALWARE_SCAN_TIMEOUT_MS=30000
