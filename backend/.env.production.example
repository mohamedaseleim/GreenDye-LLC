NODE_ENV=production
PORT=5000
FRONTEND_URL=https://consulting.greendye.org
PUBLIC_BASE_URL=https://consulting.greendye.org
MOODLE_BASE_URL=https://learning.greendye.org
MONGODB_URI=mongodb://APP_USER:APP_PASSWORD@mongodb:27017/green_consulting?authSource=green_consulting&replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRE=2h
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@greendye.org
SMTP_PASSWORD=REPLACE_FROM_SECRET_STORE
FROM_EMAIL=noreply@greendye.org
FROM_NAME=GreenDye for Training and Consultancy
ALLOW_PRODUCTION_RESTORE=false
PROJECT_STORAGE_QUOTA_BYTES=1073741824
USER_DAILY_UPLOAD_BYTES=262144000

# Optional. Automatically generated if empty.
INSTANCE_ID=

MALWARE_SCAN_ENABLED=false
CLAMSCAN_COMMAND=clamscan
MALWARE_SCAN_TIMEOUT_MS=30000
